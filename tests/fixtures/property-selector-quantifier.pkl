amends "../../schema/Definitions.pkl"

import "../../schema/Selectors.pkl"
import "../../schema/SelectorValues.pkl"
import "../../schema/Values.pkl"

package {
  id = "axioval:example.selector-quantifier"
  version = "0.1.0"
  name { default = "Selector quantifier" }
  description { default = "Property selector list quantifiers." }
}
properties {
  ["axioval:example.layers"] {
    id = "axioval:example.layers"
    name { default = "Layers" }
    valueKind = "stringList"
    externalNames {
      new { typeSystem = "axioval:example.cad"; name = "Layer" }
    }
  }
}
definitions {
  ["axioval:example.selected"] {
    id = "axioval:example.selected"
    name { default = "Selected objects" }
    capability = "axioval:example.selected"
    parameters {
      ["compared"] {
        id = "compared"
        name { default = "Compared objects" }
        kind = "selector"
        defaultValue = new SelectorValues.SelectorValue {
          value = new Selectors.AllOfSelector {
            operands {
              new Selectors.PropertySelector {
                property = "axioval:example.layers"
                operator = "oneOf"
                value = new Values.StringListValue { value { "A-WALL"; "A-DOOR" } }
                quantifier = "all"
              }
              new Selectors.PropertySelector {
                property = "axioval:example.layers"
                operator = "exists"
              }
            }
          }
        }
      }
    }
  }
}
