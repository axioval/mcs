/// Proves the expression schema refuses what the binder refuses and renders
/// the normalized form the checking application writes.
module axioval.tests.expressions

amends "pkl:test"

import "pkl:test" as test

import "../../schema/Expressions.pkl"
import "../../schema/Selectors.pkl"
import "../../schema/Values.pkl"

local measured = new Expressions.PropertyExpression {
  propertySet = "axioval:measured"
  property = "extent_z"
}

local function rendered(value: Any): String =
  new JsonRenderer {
    indent = ""
    converters {
      [Expressions.Expression] = (it) -> Expressions.normalizedExpression(it)
    }
  }.renderValue(value).replaceAll("\n", "")

facts {
  ["defaults and unset fields are omitted, label last"] {
    rendered(new Expressions.CompareExpression {
      label = "low enough"
      operator = "lessThan"
      left = measured
      right = new Expressions.LiteralExpression {
        value = new Values.QuantityValue { value = 2.5; unit = "m" }
      }
    })
      == #"{"kind":"compare","operator":"lessThan","left":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"},"right":{"kind":"literal","value":{"type":"quantity","value":2.5,"unit":"m"}},"label":"low enough"}"#
    rendered(new Expressions.BetweenExpression {
      operand = measured
      low = new Expressions.NullExpression {}
      high = new Expressions.NullExpression {}
      lowInclusive = false
    })
      == #"{"kind":"between","operand":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"},"low":{"kind":"null"},"high":{"kind":"null"},"lowInclusive":false}"#
  }

  ["lookup keys are ordered by column ID"] {
    rendered(new Expressions.LookupExpression {
      table = "limits"
      keys {
        ["zone"] = new Expressions.NullExpression {}
        ["class"] = new Expressions.NullExpression {}
      }
      column = "maximum"
    })
      == #"{"kind":"lookup","table":"limits","keys":{"class":{"kind":"null"},"zone":{"kind":"null"}},"column":"maximum"}"#
  }

  ["floor and ceil write a step only when it is set"] {
    rendered(new Expressions.FloorExpression { operand = measured })
      == #"{"kind":"floor","operand":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"}}"#
    rendered(new Expressions.CeilExpression {
      label = "whole spaces"
      operand = measured
      step = new Expressions.LiteralExpression {
        value = new Values.IntegerValue { value = 1 }
      }
    })
      == #"{"kind":"ceil","operand":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"},"step":{"kind":"literal","value":{"type":"integer","value":1}},"label":"whole spaces"}"#
  }

  ["table reads omit their default false flags"] {
    rendered(new Expressions.InterpolateExpression {
      table = "cover_by_span"
      keyColumn = "span"
      key = measured
      column = "cover"
    })
      == #"{"kind":"interpolate","table":"cover_by_span","keyColumn":"span","key":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"},"column":"cover"}"#
    rendered(new Expressions.Lookup2Expression {
      label = "cover"
      clamp = true
      interpolateRow = true
      table = "cover"
      rowKeyColumn = "span"
      rowKey = measured
      columnKeyColumn = "class"
      columnKey = new Expressions.NullExpression {}
      column = "cover"
    })
      == #"{"kind":"lookup2","table":"cover","rowKeyColumn":"span","rowKey":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"},"columnKeyColumn":"class","columnKey":{"kind":"null"},"column":"cover","interpolateRow":true,"clamp":true,"label":"cover"}"#
  }

  ["argmin and argmax write over, where, by and value in order"] {
    rendered(new Expressions.ArgmaxExpression {
      label = "steepest"
      value = new Expressions.NullExpression {}
      by = measured
      `where` = new Selectors.AllSelector {}
      over = new Expressions.GroupSource { grouping = "faces" }
    })
      == #"{"kind":"argmax","over":{"kind":"group","grouping":"faces"},"where":{"kind":"all"},"by":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"},"value":{"kind":"null"},"label":"steepest"}"#
    test.catch(() -> new Expressions.ArgminExpression {
      over = new Expressions.MeasuredSource { name = "steps" }
      `where` = new Selectors.AllSelector {}
      by = measured
      value = measured
    }.`where`).contains("MeasuredSource")
    new Expressions.ArgminExpression {
      over = new Expressions.MeasuredSource { name = "steps" }
      by = new Expressions.PropertyExpression {
        propertySet = "axioval:member"
        property = "rise"
      }
      value = new Expressions.PropertyExpression {
        propertySet = "axioval:member"
        property = "going"
      }
    }.over.kind == "measured"
  }

  ["pairs write function, over, where, by and value in order"] {
    rendered(new Expressions.PairsExpression {
      label = "rise"
      value = new Expressions.SubtractExpression {
        left = new Expressions.NextExpression { operand = measured }
        right = new Expressions.PreviousExpression { operand = measured; label = "before" }
      }
      by = measured
      `where` = new Selectors.AllSelector {}
      over = new Expressions.PathSource { path { "axioval:derived.flow:forward+" } }
      `function` = "max"
    })
      == #"{"kind":"pairs","function":"max","over":{"kind":"path","path":["axioval:derived.flow:forward+"]},"where":{"kind":"all"},"by":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"},"value":{"kind":"subtract","left":{"kind":"next","operand":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"}},"right":{"kind":"previous","operand":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"},"label":"before"}},"label":"rise"}"#
    rendered(new Expressions.PairsExpression {
      `function` = "count"
      over = new Expressions.GroupSource { grouping = "storeys" }
      by = measured
    })
      == #"{"kind":"pairs","function":"count","over":{"kind":"group","grouping":"storeys"},"by":{"kind":"property","propertySet":"axioval:measured","property":"extent_z"}}"#
    test.catch(() -> new Expressions.PairsExpression {
      `function` = "count"
      over = new Expressions.GroupSource { grouping = "storeys" }
      by = measured
      value = measured
    }.value).contains("count")
    test.catch(() -> new Expressions.PairsExpression {
      `function` = "all"
      over = new Expressions.GroupSource { grouping = "storeys" }
      by = measured
    }.value).contains("count")
    test.catch(() -> new Expressions.PairsExpression {
      `function` = "all"
      over = new Expressions.MeasuredSource { name = "steps" }
      `where` = new Selectors.AllSelector {}
      by = measured
      value = measured
    }.`where`).contains("MeasuredSource")
  }

  ["empty operand lists and branches are refused"] {
    test.catch(() -> new Expressions.AndExpression {}.operands).contains("isEmpty")
    test.catch(() -> new Expressions.OneOfExpression {
      operand = measured
    }.values).contains("isEmpty")
    test.catch(() -> new Expressions.IfExpression {
      `else` = measured
    }.branches).contains("isEmpty")
    test.catch(() -> new Expressions.LookupExpression {
      table = "limits"
      column = "maximum"
    }.keys).contains("isEmpty")
  }

  ["blank labels and names are refused"] {
    test.catch(() -> new Expressions.NullExpression { label = " " }.label).contains("isBlank")
    test.catch(() -> new Expressions.PropertyExpression { property = "" }.property)
      .contains("isPropertyName")
    test.catch(() -> new Expressions.ParameterExpression { name = "" }.name)
      .contains("matches")
    test.catch(() -> new Expressions.InterpolateExpression { keyColumn = "span key" }.keyColumn)
      .contains("matches")
    test.catch(() -> new Expressions.Lookup2Expression { rowKeyColumn = "" }.rowKeyColumn)
      .contains("matches")
  }

  ["properties are qualified concepts or derived-set names"] {
    test.catch(() -> new Expressions.PropertyExpression { property = "IsExternal" }.property)
      .contains("isPropertyName")
    test.catch(() -> new Expressions.PropertyExpression {
      propertySet = "Pset_WallCommon"
      property = "ex:is-external"
    }.propertySet).contains("matches")
    new Expressions.PropertyExpression {
      propertySet = "axioval:member"
      property = "rise"
    }.property == "rise"
  }

  ["derived-set names are checked as selectors check them"] {
    test.catch(() -> new Expressions.PropertyExpression {
      propertySet = "axioval:measured"
      property = "girth"
    }.property).contains("isPropertyName")
    test.catch(() -> new Expressions.PropertyExpression {
      propertySet = "axioval:value"
      property = "slope percent"
    }.property).contains("isPropertyName")
    new Expressions.PropertyExpression {
      propertySet = "axioval:value"
      property = "slope_percent"
    }.property == "slope_percent"
  }

  ["literals are finite scalars"] {
    test.catch(() -> new Expressions.LiteralExpression {
      value = new Values.NumberValue { value = NaN }
    }.value).contains("isFinite")
    test.catch(() -> new Expressions.LiteralExpression {
      value = new Values.QuantityValue { value = 1.0; unit = " " }
    }.value).contains("isBlank")
    test.catch(() -> new Expressions.LiteralExpression {
      value = new Values.StringListValue { value { "a" } }
    }.value).contains("Value")
    new Expressions.LiteralExpression {
      value = new Expressions.EnumLiteralValue { value = "NOTDEFINED" }
    }.value.value == "NOTDEFINED"
  }

  ["an aggregate takes a value unless it counts"] {
    test.catch(() -> new Expressions.AggregateExpression {
      `function` = "sum"
      over = new Expressions.GroupSource { grouping = "flats" }
    }.value).contains("count")
    test.catch(() -> new Expressions.AggregateExpression {
      `function` = "count"
      over = new Expressions.GroupSource { grouping = "flats" }
      value = measured
    }.value).contains("count")
  }

  ["an aggregate over measured members takes no member filter"] {
    test.catch(() -> new Expressions.AggregateExpression {
      `function` = "count"
      over = new Expressions.MeasuredSource { name = "steps" }
      `where` = new Selectors.AllSelector {}
    }.`where`).contains("MeasuredSource")
    test.catch(() -> new Expressions.MeasuredSource { name = "treads" }.name)
      .contains("isMeasuredMembers")
    new Expressions.MeasuredSource { name = "steps;walking_line_offset=0.3" }.name
      == "steps;walking_line_offset=0.3"
  }
}
