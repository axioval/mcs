{
  "schemaVersion": "0.1.0",
  "package": {
    "id": "axioval:example.geometry-clearance",
    "name": {
      "default": "IFC wall-to-pipe clearance",
      "translations": {}
    },
    "version": "0.1.0",
    "description": {
      "default": "Instructional rule using openbim.ifc names and the engine's clearance capability.",
      "translations": {}
    },
    "repository": "https://github.com/axioval/mcs",
    "authors": []
  },
  "sources": {},
  "definitionPackages": [
    "axioval:example.geometry-clearance-definitions"
  ],
  "root": {
    "id": "root",
    "name": {
      "default": "Geometry checks",
      "translations": {}
    },
    "rules": [
      {
        "id": "wall-to-pipe-clearance",
        "definitionId": "axioval:example.geometry.component-clearance",
        "name": {
          "default": "Pipe segments keep 200 mm clear of walls",
          "translations": {}
        },
        "enabled": true,
        "severity": "error",
        "parameters": {
          "sides": {
            "type": "stringList",
            "value": [
              "left",
              "right"
            ]
          },
          "front_axis": {
            "type": "string",
            "value": "forward"
          },
          "width_mode": {
            "type": "string",
            "value": "component_plus"
          },
          "width": {
            "type": "quantity",
            "value": 0,
            "unit": "mm"
          },
          "depth": {
            "type": "quantity",
            "value": 200,
            "unit": "mm"
          },
          "height_mode": {
            "type": "string",
            "value": "component_plus"
          },
          "height": {
            "type": "quantity",
            "value": 0,
            "unit": "mm"
          },
          "height_reference": {
            "type": "string",
            "value": "bottom"
          },
          "obstacles": {
            "type": "selector",
            "value": {
              "kind": "entityType",
              "objectType": "axioval:example.ifc.wall",
              "includeSubtypes": true
            }
          }
        },
        "applicability": {
          "groups": {
            "pipes": {
              "id": "pipes",
              "name": {
                "default": "Pipe segments",
                "translations": {}
              },
              "selector": {
                "kind": "entityType",
                "objectType": "axioval:example.ifc.pipe-segment",
                "includeSubtypes": true
              }
            }
          }
        },
        "requirements": [
          {
            "id": "minimum-clearance",
            "statement": {
              "default": "On its left and right, a volume 200 mm deep and as wide and high as the segment is free of walls.",
              "translations": {}
            },
            "targetGroups": [
              "pipes"
            ],
            "citations": []
          }
        ],
        "citations": [],
        "parameterCitations": [],
        "explanatoryImages": [],
        "tags": [
          "example",
          "geometry",
          "ifc"
        ]
      }
    ],
    "folders": []
  }
}
