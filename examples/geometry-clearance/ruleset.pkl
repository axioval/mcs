amends "../../schema/RuleSets.pkl"

import "../../schema/RuleSets.pkl"
import "../../schema/Selectors.pkl"
import "../../schema/SelectorValues.pkl"
import "../../schema/Types.pkl"
import "../../schema/Values.pkl"

package = new Types.PackageMetadata {
  id = "axioval:example.geometry-clearance"
  name = new Types.LocalizedText { default = "IFC wall-to-pipe clearance" }
  version = "0.1.0"
  description = new Types.LocalizedText {
    default = "Instructional rule using openbim.ifc names and the engine's clearance capability."
  }
  repository = "https://github.com/axioval/mcs"
}

definitionPackages {
  "axioval:example.geometry-clearance-definitions"
}

root = new RuleSets.RuleFolder {
  id = "root"
  name = new Types.LocalizedText { default = "Geometry checks" }
  rules {
    new RuleSets.RuleInstance {
      id = "wall-to-pipe-clearance"
      definitionId = "axioval:example.geometry.component-clearance"
      name = new Types.LocalizedText { default = "Pipe segments keep 200 mm clear of walls" }
      severity = "error"
      parameters {
        ["sides"] = new Values.StringListValue { value { "left"; "right" } }
        ["front_axis"] = new Values.StringValue { value = "forward" }
        ["width_mode"] = new Values.StringValue { value = "component_plus" }
        ["width"] = new Values.QuantityValue { value = 0; unit = "mm" }
        ["depth"] = new Values.QuantityValue { value = 200; unit = "mm" }
        ["height_mode"] = new Values.StringValue { value = "component_plus" }
        ["height"] = new Values.QuantityValue { value = 0; unit = "mm" }
        ["height_reference"] = new Values.StringValue { value = "bottom" }
        ["obstacles"] = new SelectorValues.SelectorValue {
          value = new Selectors.EntityTypeSelector {
            objectType = "axioval:example.ifc.wall"
          }
        }
      }
      applicability = new RuleSets.Applicability {
        groups {
          ["pipes"] = new RuleSets.TargetGroup {
            id = "pipes"
            name = new Types.LocalizedText { default = "Pipe segments" }
            selector = new Selectors.EntityTypeSelector {
              objectType = "axioval:example.ifc.pipe-segment"
            }
          }
        }
      }
      requirements {
        new RuleSets.Requirement {
          id = "minimum-clearance"
          statement = new Types.LocalizedText {
            default =
              "On its left and right, a volume 200 mm deep and as wide and high as the segment is free of walls."
          }
          targetGroups { "pipes" }
        }
      }
      tags { "example"; "geometry"; "ifc" }
    }
  }
}
