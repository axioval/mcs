amends "../../schema/Definitions.pkl"

import "@ifc/versions/Ifc4x3.pkl" as ifc4x3

import "../../schema/adapters/Ifc.pkl" as ifcAdapter
import "../../schema/Citations.pkl"
import "../../schema/Definitions.pkl"
import "../../schema/Types.pkl"

package = new Types.PackageMetadata {
  id = "axioval:example.din-276-331-definitions"
  version = "0.1.0"
  name = new Types.LocalizedText {
    default = "DIN 276 KG 331 example definitions"
    translations { ["de"] = "Beispieldefinitionen für DIN 276 KG 331" }
  }
  description = new Types.LocalizedText {
    default = "Instructional property vocabulary and reusable rule definition."
    translations {
      ["de"] = "Lehrvokabular für Eigenschaften und wiederverwendbare Regeldefinitionen."
    }
  }
  repository = "https://github.com/axioval/mcs"
  license = "AGPL-3.0-or-later"
  authors { "Axioval contributors" }
}

sources {
  [ifc4x3.release.sourceUri] = new Citations.Source {
    id = ifc4x3.release.sourceUri
    kind = "technicalSpecification"
    designation = ifc4x3.release.label
    title = new Types.LocalizedText { default = "Industry Foundation Classes 4.3" }
    publisher = "buildingSMART International"
    edition = ifc4x3.release.id
    url = ifc4x3.release.sourceUri
  }
}

objectTypes {
  ["axioval:example.ifc.wall"] = new Definitions.ObjectTypeDefinition {
    id = "axioval:example.ifc.wall"
    name = new Types.LocalizedText { default = "Wall" }
    externalNames {
      ifcAdapter.entityExternalName(ifc4x3.entity("IfcWall"))
    }
  }
}

properties {
  ["axioval:example.ifc.load-bearing"] = new Definitions.PropertyDefinition {
    id = "axioval:example.ifc.load-bearing"
    name = new Types.LocalizedText { default = "Load bearing" }
    description = new Types.LocalizedText {
      default = "Whether an object is intended to carry loads."
    }
    valueKind = "boolean"
    externalNames {
      new Definitions.ExternalName {
        typeSystem = "https://github.com/axioval/mcs/tree/main/examples"
        name = "axioval:example.ifc.load-bearing"
      }
    }
  }
  ["axioval:example.ifc.is-external"] = new Definitions.PropertyDefinition {
    id = "axioval:example.ifc.is-external"
    name = new Types.LocalizedText { default = "Is external" }
    description = new Types.LocalizedText {
      default = "Whether an object is designed for exterior use."
    }
    valueKind = "boolean"
    externalNames {
      new Definitions.ExternalName {
        typeSystem = "https://github.com/axioval/mcs/tree/main/examples"
        name = "axioval:example.ifc.is-external"
      }
    }
  }
}

propertySets {
  ["axioval:example.ifc.pset-wall-common"] = new Definitions.PropertySetDefinition {
    id = "axioval:example.ifc.pset-wall-common"
    name = new Types.LocalizedText { default = "Wall common properties" }
    externalNames {
      new Definitions.ExternalName {
        typeSystem = "https://github.com/axioval/mcs/tree/main/examples"
        name = "axioval:example.ifc.pset-wall-common"
      }
    }
  }
}

definitions {
  ["axioval:example.selector-conformance"] = new Definitions.RuleDefinition {
    id = "axioval:example.selector-conformance"
    name = new Types.LocalizedText { default = "Selector conformance" }
    description = new Types.LocalizedText {
      default = "Require every selected object to also match a requirement selector."
    }
    capability = "axioval:capability.selector-conformance"
    tags { "object-type" }
    parameters {
      ["requirement"] = new Definitions.ParameterDefinition {
        id = "requirement"
        name = new Types.LocalizedText { default = "Required selection" }
        kind = "selector"
      }
      ["message"] = new Definitions.ParameterDefinition {
        id = "message"
        name = new Types.LocalizedText { default = "Message" }
        kind = "string"
        required = false
      }
    }
  }
  ["axioval:example.boolean-property-equals"] = new Definitions.RuleDefinition {
    id = "axioval:example.boolean-property-equals"
    name = new Types.LocalizedText { default = "Boolean property equals" }
    description = new Types.LocalizedText {
      default = "Require a canonical boolean property to equal an expected value."
    }
    capability = "axioval:capability.property-value-equals"
    tags { "property"; "boolean" }
    parameters {
      ["property"] = new Definitions.ParameterDefinition {
        id = "property"
        name = new Types.LocalizedText { default = "Property reference" }
        kind = "propertyReference"
        referencedValueKind = "boolean"
      }
      ["expected"] = new Definitions.ParameterDefinition {
        id = "expected"
        name = new Types.LocalizedText { default = "Expected value" }
        kind = "boolean"
      }
    }
  }
}
