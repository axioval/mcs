amends "../../schema/RuleSets.pkl"

import "../../schema/Types.pkl"
import "../../schema/Values.pkl"
import "../../schema/Selectors.pkl"
import "../../schema/SelectorValues.pkl"
import "../../schema/RuleSets.pkl"
import "../../schema/Citations.pkl"

local function text(en: String, de: String): Types.LocalizedText = new Types.LocalizedText {
  default = en
  translations { ["de"] = de }
}

package = new Types.PackageMetadata {
  id = "axioval:example.din-276-331"
  version = "0.1.0"
  name = new Types.LocalizedText {
    default = "DIN 276 KG 331 load-bearing external wall example"
    translations { ["de"] = "DIN-276-KG-331-Beispiel für tragende Außenwände" }
  }
  description = new Types.LocalizedText {
    default = "Instructional DIN 276 KG 331 rule instances."
    translations { ["de"] = "Lehrbeispiele für Regelinstanzen zur DIN 276 KG 331." }
  }
  repository = "https://github.com/axioval/mcs"
  license = "AGPL-3.0-or-later"
  authors { "Axioval contributors" }
}

sources {
  ["urn:din:276:2018-12"] = new Citations.Source {
    id = "urn:din:276:2018-12"
    kind = "standard"
    designation = "DIN 276:2018-12"
    title = new Types.LocalizedText {
      default = "Building costs"
      translations { ["de"] = "Kosten im Bauwesen" }
    }
    publisher = "DIN"
    edition = "2018-12"
    publicationDate = "2018-12"
  }
}

definitionPackages {
  "axioval:example.din-276-331-definitions"
}

local kg331Objects = new Selectors.ClassificationSelector {
  system = "DIN 276:2018-12"
  code = "331"
  includeDescendants = false
}

local projectMappingNote = text(
  "KG 331 is the cited classification item; the IFC mapping is project-defined.",
  "KG 331 ist die zitierte Kostengruppe; die IFC-Zuordnung ist projektdefiniert."
)

root = new RuleSets.RuleFolder {
  id = "din-276-331"
  name = text(
    "Instructional project profile for DIN 276 KG 331",
    "Lehrbeispiel eines Projektprofils für DIN 276 KG 331"
  )
  description = text(
    "Project-defined IFC checks for objects classified as KG 331.",
    "Projektdefinierte IFC-Prüfungen für als KG 331 klassifizierte Objekte."
  )
  rules {
    new RuleSets.RuleInstance {
      id = "kg331-is-wall"
      definitionId = "axioval:example.selector-conformance"
      name = text(
        "Project profile maps KG 331 objects to walls",
        "Projektprofil ordnet KG-331-Objekte Wänden zu"
      )
      message = text(
        "The instructional project profile expects a KG 331 object to map to IfcWall.",
        "Das beispielhafte Projektprofil erwartet für ein KG-331-Objekt die Zuordnung zu IfcWall."
      )
      severity = "error"
      parameters {
        ["requirement"] = new SelectorValues.SelectorValue {
          value = new Selectors.EntityTypeSelector {
            objectType = "axioval:example.ifc.wall"
            includeSubtypes = true
          }
        }
      }
      applicability = kg331Objects
      citations {
        new Citations.Citation {
          id = "kg331-object-kind-source"
          sourceId = "urn:din:276:2018-12"
          locators { new Citations.Locator { kind = "item"; value = "KG 331" } }
          note = projectMappingNote
        }
      }
      tags { "din-276"; "cost-group-331"; "object-type" }
    }
    new RuleSets.RuleInstance {
      id = "kg331-load-bearing"
      definitionId = "axioval:example.boolean-property-equals"
      name = text(
        "Project profile marks KG 331 walls as load bearing",
        "Projektprofil kennzeichnet KG-331-Wände als tragend"
      )
      message = text(
        "The instructional project profile expects LoadBearing = TRUE in Pset_WallCommon.",
        "Das beispielhafte Projektprofil erwartet LoadBearing = TRUE in Pset_WallCommon."
      )
      severity = "error"
      parameters {
        ["property"] = new Values.PropertyReferenceValue {
          property = "axioval:example.ifc.load-bearing"
          propertySet = "axioval:example.ifc.pset-wall-common"
        }
        ["expected"] = new Values.BooleanValue { value = true }
      }
      applicability = kg331Objects
      citations {
        new Citations.Citation {
          id = "kg331-load-bearing-source"
          sourceId = "urn:din:276:2018-12"
          locators { new Citations.Locator { kind = "item"; value = "KG 331" } }
          note = projectMappingNote
        }
      }
      tags { "din-276"; "cost-group-331"; "strict-container" }
    }
    new RuleSets.RuleInstance {
      id = "kg331-is-external"
      definitionId = "axioval:example.boolean-property-equals"
      name = text(
        "Project profile marks KG 331 walls as external",
        "Projektprofil kennzeichnet KG-331-Wände als außenliegend"
      )
      message = text(
        "The instructional project profile expects IsExternal = TRUE.",
        "Das beispielhafte Projektprofil erwartet IsExternal = TRUE."
      )
      severity = "error"
      parameters {
        ["property"] = new Values.PropertyReferenceValue {
          property = "axioval:example.ifc.is-external"
        }
        ["expected"] = new Values.BooleanValue { value = true }
      }
      applicability = kg331Objects
      citations {
        new Citations.Citation {
          id = "kg331-external-source"
          sourceId = "urn:din:276:2018-12"
          locators { new Citations.Locator { kind = "item"; value = "KG 331" } }
          note = projectMappingNote
        }
      }
      tags { "din-276"; "cost-group-331"; "container-agnostic" }
    }
  }
}
