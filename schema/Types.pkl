module axioval.schema.Types

/// Current normalized interchange schema version.
const schemaVersion = "0.1.0"

/// Stable, repository-local identifier.
typealias Identifier = String(matches(Regex(#"^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"#)))

/// Stable globally qualified identifier, normally a URI.
typealias QualifiedIdentifier = String(matches(Regex(#"^[a-z][a-z0-9+.-]*:.+$"#)))

/// Semantic version without a leading `v`.
typealias SemanticVersion = String(matches(Regex(#"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$"#)))

typealias Severity = "info" | "warning" | "error"

/// The reserved property set naming the classes a ruleset's classifications
/// derive: its property names are classification IDs of the same ruleset.
const classificationSet = "axioval:classification"

/// Whether `name` can name a property in `propertySet`: a property in a
/// derived set is engine or ruleset vocabulary, any other a qualified concept
/// ID. The binder checks that the name is declared.
const function isPropertyName(propertySet: String?, name: String): Boolean =
  if (propertySet == classificationSet) !name.isBlank
  else name.matches(Regex(#"^[a-z][a-z0-9+.-]*:.+$"#))

class LocalizedText {
  /// Fallback text used when no requested translation exists.
  default: String

  /// BCP 47 language tag to translated text.
  translations: Mapping<String, String> = new {}
}

class PackageMetadata {
  /// Globally unique package identifier, normally a reverse-DNS URI.
  id: QualifiedIdentifier

  name: LocalizedText
  version: SemanticVersion
  description: LocalizedText?
  repository: String?
  license: String?
  authors: Listing<String> = new {}
}
