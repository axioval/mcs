module axioval.schema.Values

import "Types.pkl"

abstract class ParameterValue {
  type: String
}

class StringValue extends ParameterValue {
  type: "string" = "string"
  value: String
}

class BooleanValue extends ParameterValue {
  type: "boolean" = "boolean"
  value: Boolean
}

class IntegerValue extends ParameterValue {
  type: "integer" = "integer"
  value: Int
}

class NumberValue extends ParameterValue {
  type: "number" = "number"
  value: Number
}

class QuantityValue extends ParameterValue {
  type: "quantity" = "quantity"
  value: Number
  unit: String
}

class EnumValue extends ParameterValue {
  type: "enum" = "enum"
  value: Types.Identifier
}

class ReferenceValue extends ParameterValue {
  type: "reference" = "reference"
  value: Types.QualifiedIdentifier
}

class ObjectTypeReferenceValue extends ParameterValue {
  type: "objectTypeReference" = "objectTypeReference"
  objectType: Types.QualifiedIdentifier
  includeSubtypes: Boolean = true
}

/// A canonical property concept with an optional container qualifier.
/// Omit `propertySet` to resolve the property regardless of container. Supply it
/// when membership in that exact property set is part of the requirement.
class PropertyReferenceValue extends ParameterValue {
  type: "propertyReference" = "propertyReference"
  /// A property concept, in the reserved set `axioval:classification` the ID
  /// of a classification of the same ruleset, or in the reserved set
  /// `axioval:measured` a measured name such as `extent_z` or
  /// `boundary_area;kind=IfcWall`.
  property: String(Types.isPropertyName(propertySet, this))
  propertySet: Types.QualifiedIdentifier?
}

/// A calendar day of the proleptic Gregorian calendar in the years 0000 to
/// 9999, written `YYYY-MM-DD` as `xs:date` writes it. The binder refuses a day
/// that does not exist, such as `2026-02-29`.
class DateValue extends ParameterValue {
  type: "date" = "date"
  value: String(matches(Regex(#"[0-9]{4}-[0-9]{2}-[0-9]{2}"#)))
}

/// An instant with the UTC offset it is stated in, written
/// `YYYY-MM-DDThh:mm:ss`, an optional fraction of one to nine digits, and `Z`
/// or `±hh:mm`, as `xs:dateTime` writes it. The offset is required and at most
/// 14 hours; the binder refuses `-00:00`, `24:00:00`, leap seconds, and days or
/// times that do not exist.
class DateTimeValue extends ParameterValue {
  type: "dateTime" = "dateTime"
  value: String(matches(Regex(#"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})"#)))
}

class StringListValue extends ParameterValue {
  type: "stringList" = "stringList"
  value: Listing<String>
}

class ReferenceListValue extends ParameterValue {
  type: "referenceList" = "referenceList"
  value: Listing<Types.QualifiedIdentifier>
}

/// Rows of a `table` parameter, in declared order. Each row maps column IDs to
/// cells of the column's kind; a `textPattern` cell is a `StringValue`.
class TableValue extends ParameterValue {
  type: "table" = "table"
  value: Listing<Mapping<Types.Identifier, ParameterValue>>
}
