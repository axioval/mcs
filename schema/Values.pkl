module axioval.schema.Values

import "Types.pkl"

abstract class ParameterValue {
  type: String
}

class StringValue extends ParameterValue {
  type: "string" = "string"
  value: String
}

class BooleanValue extends ParameterValue {
  type: "boolean" = "boolean"
  value: Boolean
}

class IntegerValue extends ParameterValue {
  type: "integer" = "integer"
  value: Int
}

class NumberValue extends ParameterValue {
  type: "number" = "number"
  value: Number
}

class QuantityValue extends ParameterValue {
  type: "quantity" = "quantity"
  value: Number
  unit: String
}

class EnumValue extends ParameterValue {
  type: "enum" = "enum"
  value: Types.Identifier
}

class ReferenceValue extends ParameterValue {
  type: "reference" = "reference"
  value: Types.QualifiedIdentifier
}

class ObjectTypeReferenceValue extends ParameterValue {
  type: "objectTypeReference" = "objectTypeReference"
  objectType: Types.QualifiedIdentifier
  includeSubtypes: Boolean = true
}

/// A canonical property concept with an optional container qualifier.
/// Omit `propertySet` to resolve the property regardless of container. Supply it
/// when membership in that exact property set is part of the requirement.
class PropertyReferenceValue extends ParameterValue {
  type: "propertyReference" = "propertyReference"
  /// A property concept, in the reserved set `axioval:classification` the ID
  /// of a classification of the same ruleset, or in the reserved set
  /// `axioval:measured` a measured name such as `extent_z` or
  /// `boundary_area;kind=IfcWall`.
  property: String(Types.isPropertyName(propertySet, this))
  /// A property-set concept, or a reserved set such as `axioval:attributes`,
  /// which binds to itself while `property` stays a property concept.
  propertySet: Types.QualifiedIdentifier?
}

/// A calendar day of the proleptic Gregorian calendar in the years 0000 to
/// 9999, written `YYYY-MM-DD` as `xs:date` writes it, optionally followed by
/// the time zone it is stated in, `Z` or `±hh:mm` of at most 14 hours. The
/// binder refuses a day that does not exist, such as `2026-02-29`, and `-00:00`.
/// A date with a time zone never equals one without: XML Schema leaves them
/// unordered unless more than 14 hours apart.
class DateValue extends ParameterValue {
  type: "date" = "date"
  value: String(matches(Regex(#"[0-9]{4}-[0-9]{2}-[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?"#)))
}

/// An instant with the UTC offset it is stated in, written
/// `YYYY-MM-DDThh:mm:ss`, an optional fraction of one to nine digits, and `Z`
/// or `±hh:mm`, as `xs:dateTime` writes it. The offset is required and at most
/// 14 hours; the binder refuses `-00:00`, `24:00:00`, leap seconds, and days or
/// times that do not exist.
class DateTimeValue extends ParameterValue {
  type: "dateTime" = "dateTime"
  value: String(matches(Regex(#"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})"#)))
}

class StringListValue extends ParameterValue {
  type: "stringList" = "stringList"
  value: Listing<String>
}

class ReferenceListValue extends ParameterValue {
  type: "referenceList" = "referenceList"
  value: Listing<Types.QualifiedIdentifier>
}

/// Rows of a `table` parameter, in declared order. Each row maps column IDs to
/// cells of the column's kind; a `textPattern` cell is a `StringValue`.
class TableValue extends ParameterValue {
  type: "table" = "table"
  value: Listing<Mapping<Types.Identifier, ParameterValue>>
}

/// The kinds a column of a table file may have: every table column kind but
/// `selector`, which a data file cannot hold.
typealias TableFileColumnKind = "string" | "textPattern" | "number" | "quantity" | "integer" | "boolean" | "reference" | "date" | "dateTime"

/// One column of a `TableFileValue`: the table column `id` it fills, its
/// `kind`, which must be that column's, the file's `header` naming it, and
/// for a `quantity` column the `unit` every cell is stated in.
class TableFileColumn {
  id: Types.Identifier
  /// The header naming the column in the file; its `id` when unset.
  /// Normalized JSON omits it when unset.
  header: String(!isEmpty)?
  /// A `quantity` column states its `unit`, and no other column does.
  kind: TableFileColumnKind((this == "quantity") == (unit != null))
  /// Normalized JSON omits it when unset.
  unit: String(!isBlank)?
}

/// Rows of a `table` parameter taken from a data file shipped in the package
/// instead of listed: a UTF-8 CSV file, or one named `sheet` of an `.xlsx`
/// workbook. Allowed wherever a `TableValue` is.
///
/// `path` is relative to the package root, `/`-separated, without empty, `.`
/// or `..` segments. `sha256` is the lowercase hex SHA-256 of the file's
/// bytes, which pins the exact data the package was reviewed with; Pkl cannot
/// open the file, so the author states it and the binder and packer verify
/// it. `columns` declares every column of the file. The first row that is
/// not blank is the header; every later one is a row bound exactly as the
/// same row written inline. The file is data and is never executed.
class TableFileValue extends ParameterValue {
  type: "tableFile" = "tableFile"
  path: String(isTableFilePath(this))
  /// The sheet of an `.xlsx` workbook; a CSV file has none. Normalized JSON
  /// omits it when unset.
  sheet: String(!isEmpty)?(path.endsWith(".xlsx") == (this != null))
  sha256: String(matches(Regex(#"[0-9a-f]{64}"#)))
  columns: Listing<TableFileColumn>(
    !isEmpty,
    isDistinctBy((it) -> it.id),
    isDistinctBy((it) -> it.header ?? it.id)
  )
}

/// Whether `path` names a `.csv` or `.xlsx` file inside the package: relative,
/// `/`-separated, without empty, `.` or `..` segments, backslashes or `:`.
const function isTableFilePath(path: String): Boolean =
  (path.endsWith(".csv") || path.endsWith(".xlsx"))
    && !path.contains("\\")
    && !path.contains(":")
    && !path.contains("\u{0}")
    && path.split("/").every((segment) -> segment != "" && segment != "." && segment != "..")
