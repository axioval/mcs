module axioval.schema.Selectors

import "Types.pkl"
import "Values.pkl"

abstract class Selector {
  kind: String
}

/// Select every entity visible to the validation application.
class AllSelector extends Selector {
  kind: "all" = "all"
}

/// Select entities by a reusable object-type concept.
class EntityTypeSelector extends Selector {
  kind: "entityType" = "entityType"
  objectType: Types.QualifiedIdentifier
  includeSubtypes: Boolean = true
}

/// How a property selector compares the resolved property value with `value`.
///
/// - `equals` and `notEquals` compare with a value of the property's kind.
/// - `lessThan`, `lessThanOrEquals`, `greaterThan`, and `greaterThanOrEquals`
///   order integer, number, quantity, string, date, or dateTime values; dates
///   and date-times order chronologically.
/// - `matches` takes a `string` regular expression that must match the whole
///   value.
/// - `like` takes a `string` wildcard pattern that must match the whole value:
///   `*` matches any run of characters, `?` exactly one character, and `\`
///   escapes the next character.
/// - `contains` takes a `string` that must occur as a substring of the value.
/// - `oneOf` and `noneOf` take a `stringList`; each element must be a value of
///   the property's kind.
/// - `exists` takes no value.
/// - `isEmpty` holds for a value that is present but null, blank text, or a
///   list of nothing else, and `isNotEmpty` for one present with a value; an
///   absent value is neither. Both take no value.
///
/// `exists`, `isEmpty`, and `isNotEmpty` judge presence: they take no value
/// and no quantifier, and reject `caseSensitive = false` and `trim = true`.
typealias ComparisonOperator = "equals" | "notEquals" | "lessThan" | "lessThanOrEquals" | "greaterThan" | "greaterThanOrEquals" | "matches" | "like" | "contains" | "oneOf" | "noneOf" | "exists" | "isEmpty" | "isNotEmpty"

/// How a property selector compares a list-valued property element by element.
///
/// - `any` holds when at least one element satisfies the comparison.
/// - `all` holds when every element does, and never for an empty list.
///
/// A single value counts as a one-element list. `exists`, `isEmpty`, and
/// `isNotEmpty` take no quantifier.
typealias Quantifier = "any" | "all"

/// How finely a property selector compares dates and date-times.
///
/// - `day` reads every date-time as the calendar day it states in its own
///   offset, so a date-time then compares with a date, and two date-times
///   compare by day.
///
/// Without a precision a date compares with a date, a date-time with a
/// date-time as instants, and a date-time never with a date.
typealias TemporalPrecision = "day"

/// Select entities using a canonical property concept. `propertySet` is an
/// optional exact container qualifier, never an ownership hierarchy.
class PropertySelector extends Selector {
  kind: "property" = "property"
  /// A property-set concept, or a reserved set such as `axioval:attributes`,
  /// which binds to itself while `property` stays a property concept.
  propertySet: Types.QualifiedIdentifier?
  /// A property concept, in the reserved set `axioval:classification` the ID
  /// of a classification of the same ruleset, or in the reserved set
  /// `axioval:measured` a measured name such as `extent_z` or
  /// `boundary_area;kind=IfcWall`.
  property: String(Types.isPropertyName(propertySet, this))
  operator: ComparisonOperator
  value: Values.ParameterValue?
  /// `false` folds case for text comparisons: any operator comparing a
  /// string, enum, or reference value, and `matches`, `like`, `contains`,
  /// `oneOf`, and `noneOf`. Normalized JSON omits the default `true`; `false`
  /// is rejected on a presence operator and on non-text comparisons.
  caseSensitive: Boolean = true
  /// `true` strips leading and trailing whitespace from the resolved property
  /// value before a text comparison; `value` itself is never trimmed.
  /// Normalized JSON omits the default `false`; `true` is rejected on a
  /// presence operator and on non-text comparisons.
  trim: Boolean = false
  /// Compares a list-valued property element by element. Required for a
  /// comparison of a `stringList` or `referenceList` property, whose `value`
  /// is then a value of the element kind (`string` or `reference`); rejected on
  /// a presence operator. Normalized JSON omits it when unset.
  quantifier: Quantifier?
  /// Compares a `date` or `dateTime` value at the given precision; rejected
  /// with any other value and on a presence operator. With `day`, a `date` property may
  /// be compared with a `dateTime` value and the other way round. Normalized
  /// JSON omits it when unset.
  precision: TemporalPrecision?
}

/// Render a property selector without its default text-comparison flags so
/// packages that do not set them keep byte-identical normalized JSON.
const function normalizedPropertySelector(selector: PropertySelector): Map<String, Any> =
  selector.toMap().filter((key, value) ->
    value != null
    && !(key == "caseSensitive" && value == true)
    && !(key == "trim" && value == false)
  )

/// A non-empty XML Schema regular expression over names a source states, as
/// IDS names property sets and properties (`Pset_.*Common`). It matches the
/// whole name, and `^` and `$` are ordinary characters. The binder rejects
/// invalid patterns and constructs that cannot be matched exactly:
/// character-class subtraction, the `\i` and `\c` name escapes, and
/// `\p{Is…}` block escapes.
typealias NamePattern = String(!isEmpty)

/// Select entities by the properties whose property-set and property names
/// match XML Schema patterns.
///
/// The patterns match the source's own names; they name no concept and are
/// never bound through the concept catalogs. Without `propertySetPattern`
/// every property set is searched. The selector holds when at least one
/// property matches and the comparison holds for `matched` of them; no
/// matching property is no match. The other fields compare each matched
/// property's value as a property selector does.
class PropertyPatternSelector extends Selector {
  kind: "propertyPattern" = "propertyPattern"
  /// Pattern over property-set names; every set when unset. Normalized JSON
  /// omits it when unset.
  propertySetPattern: NamePattern?
  /// Pattern over property names.
  propertyPattern: NamePattern
  /// Which matched properties must satisfy the comparison: `any` needs one,
  /// `all` needs every one.
  matched: Quantifier
  operator: ComparisonOperator
  value: Values.ParameterValue?
  /// As on a property selector. Normalized JSON omits the default `true`.
  caseSensitive: Boolean = true
  /// As on a property selector. Normalized JSON omits the default `false`.
  trim: Boolean = false
  /// Compares each matched list value element by element, as on a property
  /// selector. Normalized JSON omits it when unset.
  quantifier: Quantifier?
  /// As on a property selector. Normalized JSON omits it when unset.
  precision: TemporalPrecision?
}

/// Render a property-pattern selector without its default text-comparison
/// flags and unset fields, as a property selector renders.
const function normalizedPropertyPatternSelector(
  selector: PropertyPatternSelector
): Map<String, Any> =
  selector.toMap().filter((key, value) ->
    value != null
    && !(key == "caseSensitive" && value == true)
    && !(key == "trim" && value == false)
  )

/// Select entities carrying a classification reference in `system`.
///
/// `code` names one code exactly and `codePattern` matches codes by an XML
/// Schema pattern over the whole code (`Ss_25_.*`), as IDS writes
/// classification patterns; at most one of them is given. With neither, any
/// classification in `system` matches.
class ClassificationSelector extends Selector {
  kind: "classification" = "classification"
  system: String
  /// One code, compared exactly. Normalized JSON omits it when unset.
  code: String(codePattern == null)?
  /// A pattern over whole codes, validated like a property-name pattern.
  /// Normalized JSON omits it when unset.
  codePattern: NamePattern?
  /// Also matches the codes an assignment's ancestors carry; needs `code` or
  /// `codePattern`.
  includeDescendants: Boolean(!this || code != null || codePattern != null) = false
}

/// Render a classification selector without an unset code or code pattern, so
/// packages that state a code keep byte-identical normalized JSON.
const function normalizedClassificationSelector(
  selector: ClassificationSelector
): Map<String, Any> =
  selector.toMap().filter((_, value) -> value != null)

/// Select the objects a classification of the same ruleset assigns `class`,
/// or, with `includeDescendants`, `class` or any class below it in the
/// classification's tree.
///
/// An all-match classification selects an object when any class it assigns
/// does. An unclassified object is not selected; one whose class cannot be
/// derived is not evaluated. The binder checks that `classification` is
/// declared and `class` is one of its declared classes, or for a flat
/// classification a class its rows assign, which has no descendants.
class DerivedClassSelector extends Selector {
  kind: "derivedClass" = "derivedClass"
  classification: String(!isBlank)
  `class`: String(!isBlank)
  /// Normalized JSON omits the default `false`.
  includeDescendants: Boolean = false
}

/// Render a derived-class selector without the default `includeDescendants`.
const function normalizedDerivedClassSelector(
  selector: DerivedClassSelector
): Map<String, Any> =
  selector.toMap().filter((key, value) -> !(key == "includeDescendants" && value == false))

/// A fact about a whole source that a source selector compares.
///
/// - `fileName` is the file name the checking application loaded the source
///   from.
/// - `application` is the name of every application the source states wrote
///   it.
/// - `schema` is the schema the source declares, such as `IFC4`.
/// - `project` is the name of the project the source describes.
/// - `timestamp` is when the source states it was written, as written, such
///   as the header's `FILE_NAME.time_stamp` in IFC.
typealias SourceField = "fileName" | "application" | "schema" | "project" | "timestamp"

/// Select the objects of the sources whose metadata `field` satisfies the
/// comparison, such as the application that wrote a model.
///
/// Source metadata is not an object fact: every object of a source matches or
/// none does. The field compares as a property selector's text value does. A
/// field holding several values needs `quantifier`, one the source states
/// empty matches nothing, and one the application never obtained is not evaluated,
/// never a non-match.
class SourceSelector extends Selector {
  kind: "source" = "source"
  field: SourceField
  operator: ComparisonOperator
  value: Values.ParameterValue?
  /// As on a property selector. Normalized JSON omits the default `true`.
  caseSensitive: Boolean = true
  /// As on a property selector. Normalized JSON omits the default `false`.
  trim: Boolean = false
  /// Compares a field holding several values value by value, as on a property
  /// selector. Normalized JSON omits it when unset.
  quantifier: Quantifier?
}

/// Render a source selector without its default text-comparison flags and
/// unset fields, as a property selector renders.
const function normalizedSourceSelector(selector: SourceSelector): Map<String, Any> =
  selector.toMap().filter((key, value) ->
    value != null
    && !(key == "caseSensitive" && value == true)
    && !(key == "trim" && value == false)
  )

/// A discipline name: 1 to 64 lowercase ASCII letters, digits, `-`, or `_`,
/// starting with a letter or digit. No vocabulary is fixed; names compare
/// exactly.
typealias DisciplineToken = String(matches(Regex("[a-z0-9][a-z0-9_-]{0,63}")))

/// Select the objects of every source that declares the discipline `value`.
///
/// A discipline belongs to a source, not to an object, so every object of a
/// source matches or none does. The checking application declares each
/// source's discipline; an object whose source declares none is not
/// evaluated, never a non-match.
class DisciplineSelector extends Selector {
  kind: "discipline" = "discipline"
  value: DisciplineToken
}

/// Which judgement of another rule a rule-outcome selector selects.
///
/// - `passed` holds for an object the rule selected and reported nothing about.
/// - `failed` holds for an object that is the subject of one of its findings.
typealias RuleOutcome = "passed" | "failed"

/// Select objects by how another rule of the same ruleset judged them.
///
/// `rule` is the ID of a rule instance of the same ruleset, also a disabled
/// one, never the rule the selector belongs to; rules must not depend on one
/// another's outcomes in a cycle. An object the other rule left not evaluated,
/// or could not decide whether it selected, is not evaluated, never a match or
/// a non-match. The checking application runs `rule` first.
class RuleOutcomeSelector extends Selector {
  kind: "ruleOutcome" = "ruleOutcome"
  rule: Types.Identifier
  outcome: RuleOutcome
}

class AllOfSelector extends Selector {
  kind: "allOf" = "allOf"
  operands: Listing<Selector>(length > 0)
}

class AnyOfSelector extends Selector {
  kind: "anyOf" = "anyOf"
  operands: Listing<Selector>(length > 0)
}

class NotSelector extends Selector {
  kind: "not" = "not"
  operand: Selector
}

/// How a related selector tests the objects its `path` reaches.
///
/// - `any` holds when at least one reached object matches.
/// - `all` holds when every reached object matches and at least one is reached.
/// - `none` holds when no reached object matches, also when none is reached.
typealias RelatedQuantifier = "any" | "all" | "none"

/// Select an object by the objects a relationship `path` reaches from it.
///
/// Each step is `Relationship` or `Relationship:direction`, where direction is
/// `forward` (the default), `backward`, or `either`, optionally followed by `+`
/// to take the step one or more times (`IfcRelAggregates:backward+`). A step may
/// name several relationships separated by `|`, with one direction after the
/// last applying to all, and takes any of them, mixing them along a chain
/// (`IfcRelFillsElement|IfcRelVoidsElement:backward+`); no relationship is named
/// twice and none states a direction of its own. The steps
/// are walked one after another and never reach the object itself. Relationship names are the
/// source's own names, not concepts, while the nested `selector` names concepts
/// like any other selector. A step may also name a relationship the checking
/// application derives, `axioval:derived.<name>` with optional `;key=value`
/// tolerances (`axioval:derived.adjacent-space;reach=1`), a direction, and `+`.
class RelatedSelector extends Selector {
  kind: "related" = "related"
  /// Relationship steps walked in order from the selected object.
  path: Listing<String(!isEmpty)>(length > 0)
  /// How the reached objects are tested against `selector`. Normalized JSON
  /// omits the default `any`.
  quantifier: RelatedQuantifier = "any"
  /// The selector each reached object is tested against.
  selector: Selector
}

/// Render a related selector without its default quantifier so packages that
/// do not set it keep byte-identical normalized JSON. The nested selector is
/// still rendered through the renderer's converters.
const function normalizedRelatedSelector(selector: RelatedSelector): Map<String, Any> =
  selector.toMap().filter((key, value) -> !(key == "quantifier" && value == "any"))
