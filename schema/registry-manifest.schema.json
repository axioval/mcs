{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/axioval/mcs/main/schema/registry-manifest.schema.json",
  "title": "Axioval registry package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "kind",
    "id",
    "version",
    "schemaVersion",
    "definitionEntrypoints"
  ],
  "oneOf": [
    {
      "description": "A rule set together with the definition modules it binds.",
      "properties": {
        "kind": {
          "const": "ruleset"
        }
      },
      "required": [
        "entrypoint"
      ]
    },
    {
      "description": "A library of definitions, such as rule templates, without a rule set.",
      "properties": {
        "kind": {
          "const": "definitions"
        }
      },
      "not": {
        "required": [
          "entrypoint"
        ]
      }
    }
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifestVersion": {
      "const": "0.1.0"
    },
    "kind": {
      "enum": [
        "ruleset",
        "definitions"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.-]*:.+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "schemaVersion": {
      "const": "0.1.0"
    },
    "entrypoint": {
      "description": "The rule-set module of a ruleset package; a definitions package has none.",
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.pkl$"
    },
    "definitionEntrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.pkl$"
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    }
  }
}
