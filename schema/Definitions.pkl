module axioval.schema.Definitions

import "Types.pkl"
import "Values.pkl"
import "Selectors.pkl"
import "Citations.pkl"

typealias ParameterKind = "string" | "boolean" | "integer" | "number" | "quantity" | "enum" | "reference" | "objectTypeReference" | "propertyReference" | "selector" | "stringList" | "referenceList" | "table"
typealias PropertyValueKind = "string" | "boolean" | "integer" | "number" | "quantity" | "enum" | "reference" | "stringList" | "referenceList"

/// One external-schema name for a canonical property or container concept.
class ExternalName {
  typeSystem: Types.QualifiedIdentifier
  name: String
}

/// A reusable external object type such as IFC's IfcWall.
class ObjectTypeDefinition {
  id: Types.QualifiedIdentifier
  name: Types.LocalizedText
  description: Types.LocalizedText?
  externalNames: Listing<ExternalName>(length > 0)
  citations: Listing<Citations.Citation> = new {}
}

/// A reusable semantic property. It is not owned by any property set.
class PropertyDefinition {
  id: Types.QualifiedIdentifier
  name: Types.LocalizedText
  description: Types.LocalizedText?
  valueKind: PropertyValueKind
  unitDimension: Types.QualifiedIdentifier?
  externalNames: Listing<ExternalName>(length > 0)
  citations: Listing<Citations.Citation> = new {}
}

/// A reusable external container qualifier. This does not own properties;
/// rules opt into exact membership by referencing it explicitly.
class PropertySetDefinition {
  id: Types.QualifiedIdentifier
  name: Types.LocalizedText
  description: Types.LocalizedText?
  externalNames: Listing<ExternalName>(length > 0)
  citations: Listing<Citations.Citation> = new {}
}

/// The kind of every cell in one table column. A `textPattern` cell is a
/// `Values.StringValue` holding a whole-value wildcard pattern: `*` any run of
/// characters, `?` one character, and a backslash escapes the next character.
typealias ColumnKind = "string" | "textPattern" | "number" | "quantity" | "integer" | "boolean" | "selector" | "reference"

/// One named, typed column of a `table` parameter.
class TableColumn {
  id: Types.Identifier
  name: Types.LocalizedText
  description: Types.LocalizedText?
  kind: ColumnKind
  /// Whether every row must carry a cell in this column.
  required: Boolean = true
  /// Required for, and only valid on, a `quantity` column.
  unitDimension: String?
}

class ParameterDefinition {
  id: Types.Identifier
  name: Types.LocalizedText
  description: Types.LocalizedText?
  kind: ParameterKind
  /// For `propertyReference`, optionally constrain the referenced property's value kind.
  referencedValueKind: PropertyValueKind?
  required: Boolean = true
  defaultValue: Values.ParameterValue?
  allowedValues: Listing<Values.ParameterValue> = new {}
  unitDimension: String?
  citations: Listing<Citations.Citation> = new {}
  /// The columns of a `table` parameter, in presentation order. Required for,
  /// and only valid on, `kind = "table"`; omitted from normalized JSON otherwise.
  columns: Listing<TableColumn>(!isEmpty, isDistinctBy((it) -> it.id))?
}

/// Declares a rule template. `capability` is the stable semantic operation that
/// an application must implement; it is not executable code supplied by the
/// ruleset package.
class RuleDefinition {
  id: Types.QualifiedIdentifier
  name: Types.LocalizedText
  description: Types.LocalizedText?
  capability: Types.QualifiedIdentifier
  parameters: Mapping<String, ParameterDefinition>(
    toMap().every((key, value) -> key == value.id)
  ) = new {}
  citations: Listing<Citations.Citation> = new {}
  tags: Listing<String> = new {}
}

/// Terminology package (TBox-like): definitions only, no rule instances.
schemaVersion: String = Types.schemaVersion
package: Types.PackageMetadata
sources: Mapping<String, Citations.Source>(
  toMap().every((key, value) -> key == value.id)
) = new {}
objectTypes: Mapping<String, ObjectTypeDefinition>(
  toMap().every((key, value) -> key == value.id)
) = new {}
properties: Mapping<String, PropertyDefinition>(
  toMap().every((key, value) -> key == value.id)
) = new {}
propertySets: Mapping<String, PropertySetDefinition>(
  toMap().every((key, value) -> key == value.id)
) = new {}
definitions: Mapping<String, RuleDefinition>(
  toMap().every((key, value) -> key == value.id)
) = new {}

output {
  renderer {
    // Omit defaulted property-selector flags from normalized JSON.
    converters {
      [Selectors.PropertySelector] = (it) -> Selectors.normalizedPropertySelector(it)
    }
  }
}
