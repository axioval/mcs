module axioval.schema.RuleSets

import "Types.pkl"
import "Values.pkl"
import "Selectors.pkl"
import "Citations.pkl"

typealias ImageMediaType = "image/png" | "image/jpeg" | "image/webp" | "image/svg+xml"

/// One named population participating in a rule. Requirements and capability
/// adapters target groups by `id`; folders never change this scope.
class TargetGroup {
  id: Types.Identifier
  name: Types.LocalizedText
  description: Types.LocalizedText?
  selector: Selectors.Selector
}

/// Rich applicability for rules involving one or more independently selected
/// populations, such as hosts, services, and openings.
class Applicability {
  groups: Mapping<String, TargetGroup>(
    length > 0 && toMap().every((key, value) -> key == value.id)
  )
}

/// A human-readable expected state tied to named applicability groups. Runtime
/// behavior remains owned by the rule definition's declared capability.
class Requirement {
  id: Types.Identifier
  statement: Types.LocalizedText
  description: Types.LocalizedText?
  targetGroups: Listing<Types.Identifier>(length > 0)
  citations: Listing<Citations.Citation> = new {}
}

/// A package-contained explanatory image. `path` is validated after evaluation
/// as a traversal-safe relative path whose extension matches `mediaType`.
class ExplanatoryImage {
  id: Types.Identifier
  path: String(length > 0)
  mediaType: ImageMediaType
  alternativeText: Types.LocalizedText
  caption: Types.LocalizedText?
}

/// Legacy single selectors remain valid so existing `0.1.0` packages continue
/// to evaluate. New multi-population rules should use `Applicability`.
typealias RuleApplicability = Selectors.Selector | Applicability

/// One band of a rule's `severityBands`: a finding whose relative deviation
/// `|value - bound| / |bound|` from the bound it misses lies below `below`, and
/// at or above the previous band's `below` (zero for the first band), takes
/// `severity`. A deviation at or beyond the last band keeps the rule's own
/// severity.
class SeverityBand {
  /// The band's exclusive upper threshold: finite and above zero.
  below: Float(isFinite, this > 0)
  severity: Types.Severity
}

/// Whether every band's threshold lies above the previous band's.
const function ascendingBands(bands: Listing<SeverityBand>): Boolean =
  let (thresholds = bands.toList().map((band) -> band.below))
    thresholds.isEmpty
    || thresholds.dropLast(1).zip(thresholds.drop(1)).every((pair) -> pair.first < pair.second)

/// One entry of a rule's `severityOverrides`: a finding whose subject or any
/// related object `selector` selects takes `severity`. Entries are tried in
/// order and the first that holds decides.
class SeverityOverride {
  /// Names concepts like any other selector.
  selector: Selectors.Selector
  severity: Types.Severity
}

/// One level of a rule's `categories`: the value of `property` on a finding's
/// subject, or on every object `path` reaches from it, heads the finding's
/// message in brackets, outermost level first.
class CategoryLevel {
  /// A property-set concept, or a reserved set such as `axioval:attributes`.
  /// Normalized JSON omits it when unset.
  propertySet: Types.QualifiedIdentifier?
  /// A property concept, in the reserved set `axioval:classification` the ID
  /// of a classification of the same ruleset, or in the reserved set
  /// `axioval:measured` a measured name such as `extent_z` or
  /// `boundary_area;kind=IfcWall`.
  property: String(Types.isPropertyName(propertySet, this))
  /// Steps as a related selector's `path`, in which derived relationships
  /// (`axioval:derived.…`) are also allowed; empty reads the subject itself.
  /// Normalized JSON omits it when empty.
  path: Listing<String(!isEmpty)> = new {}
}

/// Render a category level without an unset property set or an empty path.
const function normalizedCategoryLevel(level: CategoryLevel): Map<String, Any> =
  level.toMap().filter((key, value) ->
    value != null && !(key == "path" && value.isEmpty)
  )

/// When a gated rule runs, and on what.
///
/// - `allIfPassed` runs it on its whole selection if the other rule passed.
/// - `allIfFailed` runs it on its whole selection if the other rule failed.
/// - `passedObjects` narrows its selection to the objects the other rule passed.
/// - `failedObjects` narrows its selection to the objects the other rule failed.
///
/// A whole-rule gate that does not hold skips the rule; the object conditions
/// narrow its applicability as a `ruleOutcome` selector does.
typealias GateCondition = "allIfPassed" | "allIfFailed" | "passedObjects" | "failedObjects"

/// A gate on another rule of the same ruleset: the gated rule runs, or
/// selects, only as that rule's outcome allows.
class RuleGate {
  /// The ID of the rule whose outcome gates: a rule instance of the same
  /// ruleset, also a disabled one, never the gated rule itself.
  rule: Types.Identifier
  condition: GateCondition
}

class RuleInstance {
  id: Types.Identifier
  definitionId: Types.QualifiedIdentifier
  name: Types.LocalizedText
  description: Types.LocalizedText?
  enabled: Boolean = true
  severity: Types.Severity = "error"
  message: Types.LocalizedText?
  parameters: Mapping<String, Values.ParameterValue> = new {}
  applicability: RuleApplicability = new Selectors.AllSelector {}
  requirements: Listing<Requirement> = new {}
  citations: Listing<Citations.Citation> = new {}
  parameterCitations: Listing<Citations.ParameterCitation> = new {}
  explanatoryImages: Listing<ExplanatoryImage> = new {}
  tags: Listing<String> = new {}
  /// Severities graded by how far a measured value misses its bound, for
  /// capabilities that report the deviation. Thresholds ascend strictly.
  /// Normalized JSON omits it when empty.
  severityBands: Listing<SeverityBand>(ascendingBands(this)) = new {}
  /// Severities chosen by the objects a finding involves. Normalized JSON
  /// omits it when empty.
  severityOverrides: Listing<SeverityOverride> = new {}
  /// Nested categories headed before each finding's message, outermost first.
  /// Normalized JSON omits it when empty.
  categories: Listing<CategoryLevel> = new {}
  /// Runs the rule only as another rule's outcome allows. Normalized JSON
  /// omits it when unset.
  gate: RuleGate?
  /// Runs the rule only for the rules that gate on it or select by its
  /// outcome with a `ruleOutcome` selector, and reports nothing of its own. At
  /// least one enabled rule of the ruleset must do so for an enabled auxiliary
  /// rule. Normalized JSON omits it when `false`.
  auxiliary: Boolean = false
}

/// Render a rule instance without unset fields, empty refinements, or a false
/// `auxiliary`, so packages that declare none keep byte-identical normalized
/// JSON.
const function normalizedRuleInstance(rule: RuleInstance): Map<String, Any> =
  rule.toMap().filter((key, value) ->
    value != null
    && !(Set("severityBands", "severityOverrides", "categories").contains(key) && value.isEmpty)
    && !(key == "auxiliary" && value == false)
  )

class RuleFolder {
  id: Types.Identifier
  name: Types.LocalizedText
  description: Types.LocalizedText?
  rules: Listing<RuleInstance> = new {}
  folders: Listing<RuleFolder> = new {}
  /// A gate every rule in the folder and its subfolders takes, together with
  /// each rule's own. It names a rule outside the folder. Normalized JSON
  /// omits it when unset.
  gate: RuleGate?
  /// Namespaced text an importer keeps for a round trip, such as the source
  /// specification of a folder translated from another format, keyed
  /// `scheme:name` (`ids:specification`). Checking never reads it. Normalized
  /// JSON omits it when empty.
  annotations: Mapping<String(matches(Regex(#"[a-z][a-z0-9+.-]*:.+"#))), String> = new {}
}

/// Render a folder without empty annotations, so packages that declare none
/// keep byte-identical normalized JSON.
const function normalizedRuleFolder(folder: RuleFolder): Map<String, Any> =
  folder.toMap().filter((key, value) -> !(key == "annotations" && value.isEmpty))

/// How a classification's rows assign classes.
///
/// - `firstMatch` assigns the class of the first matching row, once every row
///   before it surely does not match: a string.
/// - `allMatch` assigns every matching row's class, distinct, in row order,
///   once every row is decided: a list of strings.
typealias ClassificationMode = "firstMatch" | "allMatch"

/// One row of a classification: objects `selector` selects take `class`.
class ClassificationRow {
  /// Names concepts like any other selector, and never a rule's outcome:
  /// classes are derived before any rule runs.
  selector: Selectors.Selector
  `class`: String(!isBlank)
}

/// A named classification of objects the ruleset derives from ordered rows.
///
/// Every selector, property reference, and category level of the ruleset
/// names it as the property `id` in the reserved set `axioval:classification`.
/// An object no row matches has no value, an exact absence. Classifications
/// may name one another, never in a cycle.
class ClassificationDefinition {
  id: String(!isBlank)
  name: Types.LocalizedText
  description: Types.LocalizedText?
  /// Normalized JSON omits the default `firstMatch`.
  mode: ClassificationMode = "firstMatch"
  rows: Listing<ClassificationRow>(!isEmpty)
}

/// Render a classification without an unset description or the default mode.
const function normalizedClassification(
  classification: ClassificationDefinition
): Map<String, Any> =
  classification.toMap().filter((key, value) ->
    value != null && !(key == "mode" && value == "firstMatch")
  )

/// Concrete ruleset package (ABox-like): instances reference definitions by
/// stable ID. Definition and capability resolution happens in the consuming
/// application and must fail closed when unavailable.
schemaVersion: String = Types.schemaVersion
package: Types.PackageMetadata
sources: Mapping<String, Citations.Source>(
  toMap().every((key, value) -> key == value.id)
) = new {}
definitionPackages: Listing<Types.QualifiedIdentifier>(length > 0)
root: RuleFolder
/// Classifications the ruleset derives, by ID. Normalized JSON omits it when
/// empty.
classifications: Mapping<String, ClassificationDefinition>(
  toMap().every((key, value) -> key == value.id)
) = new {}

output {
  // Omit an empty `classifications`, so packages that declare none keep
  // byte-identical normalized JSON.
  value =
    let (properties = module.toMap())
      if (properties["classifications"].isEmpty) properties.remove("classifications")
      else properties
  renderer {
    // Omit defaulted property-, property-pattern-, and source-selector flags,
    // related-selector quantifiers, unset classification codes, and empty rule
    // refinements from normalized JSON.
    converters {
      [RuleInstance] = (it) -> normalizedRuleInstance(it)
      [RuleFolder] = (it) -> normalizedRuleFolder(it)
      [CategoryLevel] = (it) -> normalizedCategoryLevel(it)
      [ClassificationDefinition] = (it) -> normalizedClassification(it)
      [Selectors.PropertySelector] = (it) -> Selectors.normalizedPropertySelector(it)
      [Selectors.PropertyPatternSelector] = (it) ->
        Selectors.normalizedPropertyPatternSelector(it)
      [Selectors.RelatedSelector] = (it) -> Selectors.normalizedRelatedSelector(it)
      [Selectors.ClassificationSelector] = (it) ->
        Selectors.normalizedClassificationSelector(it)
      [Selectors.SourceSelector] = (it) -> Selectors.normalizedSourceSelector(it)
    }
  }
}
